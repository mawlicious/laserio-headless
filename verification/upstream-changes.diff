@@ -317,3 +315,55 @@
 tasks.withType(JavaCompile).configureEach {
     options.encoding = 'UTF-8' // Use the UTF-8 charset for Java compilation
 }
+
+// Standalone checks run against the packaged mod rather than dev-only classes.
+sourceSets {
+    verification {
+        java.srcDir 'verification'
+        compileClasspath += sourceSets.main.output
+    }
+}
+
+tasks.register('verifyColorCompatibility', JavaExec) {
+    group = 'verification'
+    description = 'Compare packed colors and saved ARGB values against AWT.'
+    dependsOn 'verificationClasses', 'reobfJar'
+    classpath = files(tasks.named('jar').flatMap { it.archiveFile }) + sourceSets.verification.output
+    mainClass = 'ColorCompatibilityTest'
+    jvmArgs '-Djava.awt.headless=true'
+}
+
+tasks.register('verifyNoDesktop', JavaExec) {
+    group = 'verification'
+    description = 'Initialize and restore colors without the Java desktop module.'
+    dependsOn 'verificationClasses', 'reobfJar'
+    classpath = files(tasks.named('jar').flatMap { it.archiveFile }) + sourceSets.verification.output
+    mainClass = 'NoDesktopSmokeTest'
+    jvmArgs '--limit-modules', 'java.base'
+}
+
+tasks.register('verifyHeadlessJar') {
+    group = 'verification'
+    description = 'Reject AWT/Swing references anywhere in the packaged Forge mod.'
+    dependsOn 'reobfJar'
+    doLast {
+        def artifact = tasks.named('jar').get().archiveFile.get().asFile
+        def desktopReferences = []
+        def classCount = 0
+        zipTree(artifact).matching { include '**/*.class' }.each { entry ->
+            classCount++
+            def bytecode = new String(entry.bytes, java.nio.charset.StandardCharsets.ISO_8859_1)
+            if (bytecode.contains('java/awt') || bytecode.contains('javax/swing')) {
+                desktopReferences.add(entry.name)
+            }
+        }
+        if (classCount == 0 || !desktopReferences.empty) {
+            throw new GradleException("Invalid headless jar: ${classCount} classes, desktop references ${desktopReferences}")
+        }
+        logger.lifecycle("Verified ${classCount} packaged classes: zero AWT/Swing references.")
+    }
+}
+
+tasks.named('check') {
+    dependsOn 'verifyColorCompatibility', 'verifyNoDesktop', 'verifyHeadlessJar'
+}
